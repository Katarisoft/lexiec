# Entorno de PRODUCCIÓN de LexiEC (E20). Plantilla SIN secretos.
# Copiar en el VPS a un archivo fuera del repositorio o a infra/.env.production
# (ignorado por git), con permisos 600, y rellenar los valores marcados.

# --- Django ---
DJANGO_DEBUG=0
# OBLIGATORIA: generar una propia (por ejemplo, con
# python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=leixec.katarisoft.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://lexiec.katarisoft.com
# Solo con Nginx terminando HTTPS y enviando X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=1
DJANGO_HSTS_SECONDS=3600
DJANGO_LOG_LEVEL=WARNING

# --- PostgreSQL (lo usan tanto el contenedor db como el backend) ---
POSTGRES_DB=lexiec
POSTGRES_USER=lexiec
# OBLIGATORIA: contraseña larga y aleatoria, solo en este archivo.
POSTGRES_PASSWORD=

# --- Límites de la API ---
API_THROTTLE_LOGIN=10/min
API_THROTTLE_REGISTER=5/hour
API_THROTTLE_CONSULTATION=5/min

# --- Asistente y presupuesto (ver docs/PRESUPUESTO.md) ---
ASSISTANT_PROVIDER=anthropic
# 0 = sin llamadas reales. Solo el propietario lo pone en 1 tras autorizarlo.
ASSISTANT_LIVE_CALLS=0
ASSISTANT_MODEL=claude-haiku-5-5
ASSISTANT_PRICE_INPUT_PER_MTOK=0.10
ASSISTANT_PRICE_OUTPUT_PER_MTOK=0.50
ASSISTANT_PRICE_TIER_INPUT_LIMIT=100000
ASSISTANT_MAX_INPUT_TOKENS=8000
ASSISTANT_MAX_OUTPUT_TOKENS=2048
ASSISTANT_DAILY_LIMIT_PER_USER=10
ASSISTANT_EFFORT=low
ASSISTANT_TIMEOUT_SECONDS=30
ASSISTANT_MIN_COVERAGE=0.5
AI_BUDGET_USD=10
AI_OPERATING_LIMIT_USD=8
# Solo en el servidor; nunca en el repositorio, la app ni --dart-define.
ANTHROPIC_API_KEY=
