# Ejemplo de bloque para el Nginx YA EXISTENTE en el VPS (E20).
# No sustituye la configuración actual: revisar y adaptar a mano.
# Supone que el certificado HTTPS ya está gestionado (p. ej., con certbot)
# y que el backend escucha en 127.0.0.1:8001 (LEXIEC_BACKEND_PORT).

server {
    listen 443 ssl;
    http2 on;
    server_name leixec.katarisoft.com;

    # Rutas de certificado: usar las que ya gestione el VPS.
    # ssl_certificate     /etc/letsencrypt/live/leixec.katarisoft.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/leixec.katarisoft.com/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Mayor que el timeout del proveedor de IA (30 s) y del gunicorn (60 s).
        proxy_read_timeout 70s;
    }
}

server {
    listen 80;
    server_name leixec.katarisoft.com;
    return 301 https://$host$request_uri;
}
