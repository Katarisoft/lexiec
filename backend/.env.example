# Ejemplo de variables de entorno del backend de LexiEC.
# Copia este archivo a backend/.env y rellena los valores en tu equipo.
# Nunca versiones el archivo .env real ni pegues secretos en el repositorio.

# Activa el modo de desarrollo solo en local (1 = activo, 0 = inactivo).
DJANGO_DEBUG=1

# Obligatoria cuando DJANGO_DEBUG=0. Genera una propia; no reutilices ejemplos.
DJANGO_SECRET_KEY=

# Hosts permitidos separados por comas (por ejemplo: localhost,127.0.0.1).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a PostgreSQL.
POSTGRES_DB=lexiec
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
