# Ejemplo de variables de entorno del backend de LexiEC.
# Copia este archivo a backend/.env y rellena los valores en tu equipo.
# Django lo carga automáticamente (python-dotenv); las variables ya definidas
# en el entorno tienen prioridad. Otra ruta: DJANGO_ENV_FILE=/ruta/al/archivo.
# Nunca versiones el archivo .env real ni pegues secretos en el repositorio.

# Activa el modo de desarrollo solo en local (1 = activo, 0 = inactivo).
DJANGO_DEBUG=1

# Obligatoria cuando DJANGO_DEBUG=0. Genera una propia; no reutilices ejemplos.
DJANGO_SECRET_KEY=

# Hosts permitidos separados por comas (por ejemplo: localhost,127.0.0.1).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Conexión a PostgreSQL.
POSTGRES_DB=lexiec
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Límites de intentos por IP (formato de DRF: N/sec|min|hour|day). Opcionales.
API_THROTTLE_LOGIN=10/min
API_THROTTLE_REGISTER=5/hour

# Asistente: cobertura mínima de palabras clave (0-1) para considerar que hay
# respaldo. Provisional hasta la evaluación de E18. Opcional.
ASSISTANT_MIN_COVERAGE=0.5

# Presupuesto de IA (E15). Proveedor único: Anthropic. No hay llamadas reales
# sin autorización expresa del propietario para cada lote.
ASSISTANT_MODEL=claude-haiku-5-5
# Tarifas USD por millón de tokens. OBLIGATORIAS (sin ellas, fallo cerrado).
# Verificar en la página oficial de precios antes de usarlas.
ASSISTANT_PRICE_INPUT_PER_MTOK=
ASSISTANT_PRICE_OUTPUT_PER_MTOK=
ASSISTANT_PRICE_TIER_INPUT_LIMIT=100000
ASSISTANT_MAX_INPUT_TOKENS=8000
ASSISTANT_MAX_OUTPUT_TOKENS=1024
ASSISTANT_DAILY_LIMIT_PER_USER=10
AI_BUDGET_USD=10
AI_OPERATING_LIMIT_USD=8
